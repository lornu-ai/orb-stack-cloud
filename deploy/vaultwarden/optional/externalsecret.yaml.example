# OPTIONAL alternative to SOPS: pull vaultwarden-admin from an external store
# via External Secrets Operator. Not referenced by any kustomization; to use it,
# copy to overlays/orbstack/externalsecret.yaml, list it in that kustomization
# instead of secret.sops.yaml, and point secretStoreRef at a real store.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: vaultwarden-admin
  namespace: vaultwarden
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: REPLACE_WITH_CLUSTER_SECRET_STORE
  target:
    name: vaultwarden-admin
    creationPolicy: Owner
  data:
    - secretKey: ADMIN_TOKEN
      remoteRef:
        key: REPLACE_WITH_REMOTE_KEY # value: argon2id PHC string, never plaintext
        property: ADMIN_TOKEN
    - secretKey: SMTP_PASSWORD
      remoteRef:
        key: REPLACE_WITH_REMOTE_KEY
        property: SMTP_PASSWORD
