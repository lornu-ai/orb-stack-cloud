# TEMPLATE ONLY - placeholder values, never commit real values in plaintext.
#
#   cp secret.sops.yaml.example secret.sops.yaml
#   # fill in values, then encrypt in place (rule comes from /.sops.yaml):
#   sops --encrypt --in-place secret.sops.yaml
#   # uncomment `- secret.sops.yaml` in kustomization.yaml and commit.
#
# ADMIN_TOKEN must be an argon2id PHC string from `vaultwarden hash`, e.g.
#   $argon2id$v=19$m=65540,t=3,p=4$<salt>$<hash>
# Use single quotes in YAML so the `$` characters are kept literally.
apiVersion: v1
kind: Secret
metadata:
  name: vaultwarden-admin
  namespace: vaultwarden
type: Opaque
stringData:
  ADMIN_TOKEN: '$argon2id$v=19$m=65540,t=3,p=4$REPLACE_SALT$REPLACE_HASH'
  # Optional; only needed when SMTP_* is configured in the overlay.
  SMTP_PASSWORD: 'REPLACE_ME'
