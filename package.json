{
  "name": "orb-stack-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "tools:install": "bun run tests/tools/install.ts",
    "verify:tier1": "bun run tests/tier1/main.ts",
    "verify:engine": "bun run tests/tier2/main.ts",
    "verify:local-mesh": "bun --use-system-ca run tests/tier3/local-mesh-main.ts",
    "verify:remote-probe": "bun run tests/tier3/remote-probe-main.ts",
    "verify:gce": "bun run tests/tier4/gce-main.ts",
    "verify:aws-parity": "bun run tests/tier4/aws-parity-main.ts",
    "verify:isolation": "bun run tests/tier5/main.ts",
    "report:bigquery": "bun run tests/tier4/bigquery-main.ts",
    "cleanup": "bun run tests/cleanup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "ajv": "^8.17.1",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
